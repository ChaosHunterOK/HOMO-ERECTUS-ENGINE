function hasSelectedNote()
{
	return !arrayIsEmpty(curSelectedNote) && curSelectedNote[1] > -1;
}

var eventDropDown;
var descText;
var selectedEventText;
function addEventsUI()
{
	var tab_group_event = new FlxUI(null, UI_box);
	tab_group_event.name = 'Events';

	if (sysTarget)
	{
		var eventPushedMap = new Map();
		var directories = [SUtil.getPath() + 'assets/images/custom_events/'];
		for (i in 0...directories.length) {
			var directory =  directories[i];
			if(FNFAssets.exists(directory))
			{	
				for (file in FileSystem.readDirectory(directory)) {
					var path = IoPath.join([directory, file]);
					if (!FileSystem.isDirectory(path) && file != 'readme.txt' && StringTools.endsWith(file, '.txt')) {
						var fileToCheck = file.substr(0, file.length - 4);
						if(!eventPushedMap.exists(fileToCheck)) {
							eventPushedMap.set(fileToCheck, true);
							eventStuff.push([fileToCheck, FNFAssets.getText(path)]);
						}
					}
				}
			}
		}
		eventPushedMap.clear();
		eventPushedMap = null;
	}
	var textEventLabel = new FlxText(15, 10, 0, "Active Target Event:");
	tab_group_event.add(textEventLabel);

	var leEvents = []; 
	for (i in 0...eventStuff.length) { 
		leEvents.push(eventStuff[i][0]); 
	}

	eventDropDown = new FlxUIDropDownMenuCustom(15, 25, FlxUIDropDownMenuCustom.makeStrIdLabelArray(leEvents, true), function(pressed) {
		var selectedEvent = Std.parseInt(pressed);
		descText.text = eventStuff[selectedEvent][1];
		if (!arrayIsEmpty(curSelectedNote) && eventStuff != null)
		{
			if (!arrayIsEmpty(curSelectedNote) && curSelectedNote[2] == null)
			{
				curSelectedNote[1][curEventSelected][0] = eventStuff[selectedEvent][0];
			}
			updateGrid();
		}
	});
	blockPressWhileScrolling.push(eventDropDown);

	var labelVal1 = new FlxText(15, 65, 0, "Parameter/Value 1:");
	value1InputText = new FlxUIInputText(15, 80, 110, "");
	blockPressWhileTypingOn.push(value1InputText);

	var labelVal2 = new FlxText(15, 115, 0, "Parameter/Value 2:");
	value2InputText = new FlxUIInputText(15, 130, 110, "");
	blockPressWhileTypingOn.push(value2InputText);

	var labelVal3 = new FlxText(15, 165, 0, "Parameter/Value 3:");
	value3InputText = new FlxUIInputText(15, 180, 110, "");
	blockPressWhileTypingOn.push(value3InputText);
	var removeButton = new FlxButton(150, 25, 'Delete Node (-)', function() {
		if(!arrayIsEmpty(curSelectedNote) && curSelectedNote[2] == null) {
			if(curSelectedNote[1].length < 2) {
				_song.events.remove(curSelectedNote);
				curSelectedNote = null;
			} else {
				curSelectedNote[1].remove(curSelectedNote[1][curEventSelected]);
			}
			var eventsGroup;
			--curEventSelected;
			if(curEventSelected < 0) curEventSelected = 0;
			else if(!arrayIsEmpty(curSelectedNote) && curEventSelected >= (eventsGroup = curSelectedNote[1]).length) curEventSelected = eventsGroup.length - 1;
			changeEventSelected(0);
			updateGrid();
		}
	});
	removeButton.color = 0xFFd9534f;
	removeButton.label.color = 0xFFffffff;

	var addButton = new FlxButton(150, 50, 'Insert Node (+)', function() {
		if(!arrayIsEmpty(curSelectedNote) && curSelectedNote[2] == null) {
			var eventsGroup = curSelectedNote[1];
			eventsGroup.push(['', '', '']);
			changeEventSelected(1);
			updateGrid();
		}
	});
	addButton.color = 0xFF5cb85c;
	addButton.label.color = 0xFFffffff;

	var moveLeftButton = new FlxButton(150, 80, 'Prev Group (<)', function() {
		changeEventSelected(-1);
	});
		
	var moveRightButton = new FlxButton(150, 105, 'Next Group (>)', function() {
		changeEventSelected(1);
	});

	selectedEventText = new FlxText(150, 135, 120, 'Selected Event: None');
	selectedEventText.alignment = 'left';
	descText = new FlxText(15, 230, 260, eventStuff[0][0]); 
	descText.setFormat(null, 8, 0xFFe6e6e6, "left");

	tab_group_event.add(removeButton); 
	tab_group_event.add(addButton);
	tab_group_event.add(moveLeftButton);
	tab_group_event.add(moveRightButton);
	tab_group_event.add(selectedEventText);
	
	tab_group_event.add(labelVal1);
	tab_group_event.add(value1InputText);
	tab_group_event.add(labelVal2);
	tab_group_event.add(value2InputText);
	tab_group_event.add(labelVal3);
	tab_group_event.add(value3InputText);
	tab_group_event.add(eventDropDown);
	tab_group_event.add(descText);
	
	UI_box.addGroup(tab_group_event);
}

function changeEventSelected(change)
{
	if(!arrayIsEmpty(curSelectedNote) && curSelectedNote[2] == null) //Is event note
	{
		curEventSelected += change;
		if(curEventSelected < 0) curEventSelected = Std.int(curSelectedNote[1].length) - 1;
		else if(curEventSelected >= curSelectedNote[1].length) curEventSelected = 0;
		selectedEventText.text = 'Selected Event: ' + (curEventSelected + 1) + ' / ' + curSelectedNote[1].length;
	}
	else
	{
		curEventSelected = 0;
		selectedEventText.text = 'Selected Event: None';
	}
	updateNoteUI();
}

function setAllLabelsOffset(button, x, y)
{
	for (point in button.labelOffsets)
	{
		point.set(x, y);
	}
}

var instVolume;
var voicesVolume;
var stepperPlaybackRate;

function addChartingUI()
{
	var tab_group_chart = new FlxUI(null, UI_box);
	tab_group_chart.name = 'Charting';

	var check_mute_inst = new FlxUICheckBox(10, 200, null, null, "Mute Instrumental (in editor)", 100);
	check_mute_inst.checked = false;
	check_mute_inst.callback = function()
	{
		var vol = 1;

		if (check_mute_inst.checked)
			vol = 0;

		FlxG.sound.music.volume = vol;
	};

	check_warnings = new FlxUICheckBox(10, 120, null, null, "Ignore Progress Warnings", 100);
	if (FlixG.save.data.ignoreWarnings == null) FlixG.save.data.ignoreWarnings = false;
	check_warnings.checked = FlixG.save.data.ignoreWarnings;

	check_warnings.callback = function()
	{
		FlixG.save.data.ignoreWarnings = check_warnings.checked;
		ignoreWarnings = FlixG.save.data.ignoreWarnings;
	};

	var check_mute_vocals = new FlxUICheckBox(check_mute_inst.x + 120, check_mute_inst.y, null, null, "Mute Vocals (in editor)", 100);
	check_mute_vocals.checked = false;
	check_mute_vocals.callback = function()
	{
		if(vocals != null) {
			var vol = 1;

			if (check_mute_vocals.checked)
				vol = 0;

			vocals.volume = vol;
		}
	};

	playSoundBf = new FlxUICheckBox(check_mute_inst.x, check_mute_vocals.y + 30, null, null, 'Play Sound (Player notes)', 100,
		function() {
			FlixG.save.data.chart_playSoundBf = playSoundBf.checked;
		}
	);
	if (FlixG.save.data.chart_playSoundBf == null) FlixG.save.data.chart_playSoundBf = false;
	playSoundBf.checked = FlixG.save.data.chart_playSoundBf;

	playSoundDad = new FlxUICheckBox(check_mute_inst.x + 120, playSoundBf.y, null, null, 'Play Sound (Opponent notes)', 100,
		function() {
			FlixG.save.data.chart_playSoundDad = playSoundDad.checked;
		}
	);
	if (FlixG.save.data.chart_playSoundDad == null) FlixG.save.data.chart_playSoundDad = false;
	playSoundDad.checked = FlixG.save.data.chart_playSoundDad;

	check_waveform = new FlxUICheckBox(check_mute_inst.x, playSoundBf.y + 30, null, null, 'Show Waveform', 100);
	if (FlixG.save.data.chart_showWaveform == null) FlixG.save.data.chart_showWaveform = true;
	showWaveform = FlixG.save.data.chart_showWaveform;
	check_waveform.checked = showWaveform;
	check_waveform.callback = function()
	{
		showWaveform = check_waveform.checked;
		FlixG.save.data.chart_showWaveform = showWaveform;
		//updateWaveform();
	};

	instVolume = new FlxUINumericStepper(15, 270, 0.1, 1, 0, 1, 1);
	instVolume.value = FlxG.sound.music.volume;
	instVolume.name = 'inst_volume';
	blockPressWhileTypingOnStepper.push(instVolume);

	voicesVolume = new FlxUINumericStepper(instVolume.x + 100, instVolume.y, 0.1, 1, 0, 1, 1);
	if(vocals != null) 
	voicesVolume.value = vocals.volume;
	else
	voicesVolume.value = 0;
	voicesVolume.name = 'voices_volume';
	blockPressWhileTypingOnStepper.push(voicesVolume);
	stepperPlaybackRate = new FlxUINumericStepper(15, 330, 0.05, 1, 0.25, 2.0, 2);
	stepperPlaybackRate.value = 1.0;
	stepperPlaybackRate.name = 'playback_rate';
	blockPressWhileTypingOnStepper.push(stepperPlaybackRate);

	tab_group_chart.add(new FlxText(instVolume.x, instVolume.y - 15, 0, 'Inst Volume'));
	tab_group_chart.add(new FlxText(voicesVolume.x, voicesVolume.y - 15, 0, 'Voices Volume'));
	tab_group_chart.add(new FlxText(stepperPlaybackRate.x, stepperPlaybackRate.y - 15, 0, 'Playback Rate'));
