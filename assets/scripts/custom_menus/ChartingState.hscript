var stepperSectionTimeSigDen;

function addSectionUI()
{
	var tab_group_section = new FlxUI(null, UI_box);
	tab_group_section.name = 'Section';

	stepperLength = new FlxUINumericStepper(10, 10, 4, 0, 0, 999, 0);
	stepperLength.value = _song.notes[curSection].lengthInSteps;
	stepperLength.name = "section_length";
	blockPressWhileTypingOnStepper.push(stepperLength);

	stepperSectionBPM = new FlxUINumericStepper(10, 80, 1, Conductor.bpm, 0, 999, 0);
	stepperSectionBPM.value = Conductor.bpm;
	stepperSectionBPM.name = 'section_bpm';
	blockPressWhileTypingOnStepper.push(stepperSectionBPM);

	stepperAltAnim = new FlxUINumericStepper(10, 200, 1, Conductor.bpm, 0, 999, 0);
	stepperAltAnim.value = 0;
	stepperAltAnim.name = 'alt_anim_number';
	blockPressWhileTypingOnStepper.push(stepperAltAnim);

	stepperSectionTimeSigNum = new FlxUINumericStepper(160, 80, 1, _song.timeSigNumerator, 1, 32, 0);
	stepperSectionTimeSigNum.value = _song.timeSigNumerator;
	stepperSectionTimeSigNum.name = 'section_timesig_num';
	blockPressWhileTypingOnStepper.push(stepperSectionTimeSigNum);

	stepperSectionTimeSigDen = new FlxUINumericStepper(220, 80, 1, _song.timeSigDenominator, 1, 32, 0);
	stepperSectionTimeSigDen.value = _song.timeSigDenominator;
	stepperSectionTimeSigDen.name = 'section_timesig_den';
	blockPressWhileTypingOnStepper.push(stepperSectionTimeSigDen);

	var stepperCopy = new FlxUINumericStepper(110, 130, 1, 1, -999, 999, 0);
	blockPressWhileTypingOnStepper.push(stepperCopy);

	var copyButton = new FlxButton(10, 130, "Copy last section", function()
	{
		copySection(Std.int(stepperCopy.value));
	});

	var copyCurSection = new FlxButton(210, 130, "Copy sect", function()
	{
		copyedSection = curSection;
	});

	var pasteCurSection = new FlxButton(210, 150, "Paste sect", function()
	{
		copySection(Std.int(copyedSection));
	});

	var clearSectionButton = new FlxButton(10, 150, "Clear", clearSection);

	var swapSection = new FlxButton(10, 170, "Swap section", function()
	{
		for (i in 0..._song.notes[curSection].sectionNotes.length)
		{
			var note = _song.notes[curSection].sectionNotes[i];
			if(note[1] > -1) {
				note[1] = (note[1] + Main.ammo[_song.mania]) % (Main.ammo[_song.mania] * 2);
				_song.notes[curSection].sectionNotes[i] = note;
			}
			//updateGrid();
		}
		updateGrid();
	});

	check_mustHitSection = new FlxUICheckBox(10, 30, null, null, "Must hit section", 100);
	check_mustHitSection.name = 'check_mustHit';
	check_mustHitSection.checked = true;
	// _song.needsVoices = check_mustHit.checked;

	check_altAnim = new FlxUICheckBox(10, 220, null, null, "Alt Animation", 100);
	check_altAnim.name = 'check_altAnim';

	check_crossfadeBf = new FlxUICheckBox(10, 240, null, null, "Player Crossfade", 100);
	check_crossfadeBf.name = 'check_crossfadeBf';

	check_crossfadeDad = new FlxUICheckBox(160, 240, null, null, "Opponent Crossfade", 100);
	check_crossfadeDad.name = 'check_crossfadeDad';

	check_changeBPM = new FlxUICheckBox(10, 60, null, null, 'Change BPM', 100);
	check_changeBPM.name = 'check_changeBPM';

	check_changeTimeSig = new FlxUICheckBox(160, 60, null, null, 'Change Time Sig', 100);
	check_changeTimeSig.name = 'check_changeTimeSig';

	tab_group_section.add(stepperLength);
	tab_group_section.add(stepperSectionBPM);
	tab_group_section.add(stepperCopy);
	tab_group_section.add(copyCurSection);
	tab_group_section.add(pasteCurSection);
	tab_group_section.add(check_mustHitSection);
	tab_group_section.add(check_altAnim);
	tab_group_section.add(stepperAltAnim);
	tab_group_section.add(check_changeBPM);
	tab_group_section.add(check_changeTimeSig);
	tab_group_section.add(stepperSectionTimeSigNum);
	tab_group_section.add(stepperSectionTimeSigDen);
	tab_group_section.add(copyButton);
	tab_group_section.add(clearSectionButton);
	tab_group_section.add(swapSection);
	tab_group_section.add(check_crossfadeBf);
	tab_group_section.add(check_crossfadeDad);
	UI_box.addGroup(tab_group_section);
}

var playSoundBf = null;
var playSoundDad = null;
var check_warnings = null;
var diffDropDown;
var stepperSongTimeSigNum;
var stepperSongTimeSigDen;
function addSongUI()
{
	var tab_group_song = new FlxUI(null, UI_box);
	tab_group_song.name = "Song";
	var labelSongTitle = new FlxText(15, 10, 0, "Song Title:", 8);
	var UI_songTitle = new FlxUIInputText(15, 23, 110, _song.song, 8);
	blockPressWhileTypingOn.push(UI_songTitle);
	typingShit = UI_songTitle;

	var labelBpmSong = new FlxText(15, 53, 0, "BPM:", 8);
	var stepperBPM = new FlxUINumericStepper(15, 66, 1, Conductor.bpm, 1, 339, 0);
	stepperBPM.value = Conductor.bpm;
	stepperBPM.name = 'song_bpm';
	blockPressWhileTypingOnStepper.push(stepperBPM);

	var labelSpeed = new FlxText(15, 96, 0, "Song Speed:", 8);
	var stepperSpeed = new FlxUINumericStepper(15, 109, 0.1, 1, 0.1, 10, 1);
	stepperSpeed.value = _song.speed;
	stepperSpeed.name = 'song_speed';
	blockPressWhileTypingOnStepper.push(stepperSpeed);

	var labelTimeSig = new FlxText(150, 230, 0, "Time Signature:", 8);
	stepperSongTimeSigNum = new FlxUINumericStepper(150, 245, 1, _song.timeSigNumerator, 1, 32, 0);
	stepperSongTimeSigNum.value = _song.timeSigNumerator;
	stepperSongTimeSigNum.name = 'song_timesig_num';
	blockPressWhileTypingOnStepper.push(stepperSongTimeSigNum);

	stepperSongTimeSigDen = new FlxUINumericStepper(210, 245, 1, _song.timeSigDenominator, 1, 32, 0);
	stepperSongTimeSigDen.value = _song.timeSigDenominator;
	stepperSongTimeSigDen.name = 'song_timesig_den';
	blockPressWhileTypingOnStepper.push(stepperSongTimeSigDen);

	var labelDiff = new FlxText(15, 139, 0, "Song Target Difficulty:", 8);
	diffDropDown = new FlxUIDropDownMenuCustom(15, 152, FlxUIDropDownMenuCustom.makeStrIdLabelArray(difficultyChoices, true), function(pressed) {
		var selectedDiff = Std.parseInt(pressed);
		curDifficulty = getDiffByArray(difficultyChoices[selectedDiff]);
	});
	diffDropDown.selectedLabel = allDiffs[PlayState.storyDifficulty];

	var labelMania = new FlxText(15, 192, 0, "Key Mode (Mania):", 8);
	var stepperMania = new FlxUINumericStepper(15, 205, 1, 0, 0, 3, 1);
	stepperMania.value = _song.mania;
	stepperMania.name = 'mania';
	blockPressWhileTypingOnStepper.push(stepperMania);

	var check_voices = new FlxUICheckBox(15, 245, null, null, "Has voice track", 100);
	check_voices.checked = _song.needsVoices;
	check_voices.callback = function() {
		_song.needsVoices = check_voices.checked;
	};
	var saveButton = new FlxButton(190, 20, "Save JSON", function() {
		saveLevel();
	});

	var saveEventsBtn = new FlxButton(190, 45, "Save Events", function () {
		saveEvents();
	});

	var reloadSong = new FlxButton(190, 75, "Reload Audio", function() {
		loadSong(_song.song);
	});

	var reloadSongJson = new FlxButton(190, 100, "Reload JSON", function() {
		loadJson(_song.song.toLowerCase());
	});

	var loadAutosaveBtn = new FlxButton(190, 125, 'Load Autosave', loadAutosave);

	var loadEventJson = new FlxButton(190, 150, 'Load Events', function() {
		var songName = _song.song.toLowerCase();
		var file = SUtil.getPath() + 'assets/data/' + songName + '/events.json';
		if (FNFAssets.exists(file)) {
			clearEvents();
			var events = Song.loadFromJson('events', songName);
			_song.events = events.events;
			changeSection(curSection, true);
		}
	});

	var isMoodyCheck = new FlxUICheckBox(15, 280, null, null, "Is Moody", 100);
	var isSpookyCheck = new FlxUICheckBox(110, 280, null, null, "Is Spooky", 100);
	var isHeyCheck = new FlxUICheckBox(15, 305, null, null, "Is Hey", 100);
	var isCheerCheck = new FlxUICheckBox(110, 305, null, null, "Is Cheer", 100);

	isMoodyCheck.name = "isMoody";
	isHeyCheck.name = "isHey";
	isCheerCheck.name = "isCheer";
	isSpookyCheck.name = 'isSpooky';

	isMoodyCheck.checked = _song.isMoody;
	isSpookyCheck.checked = _song.isSpooky;
	isHeyCheck.checked = _song.isHey;
	isCheerCheck.checked = _song.isCheer;
	var clear_events = new FlxButton(190, 280, 'Clear Events', function() { 
		openSubState(new Prompt('This action will clear current progress.\n\nProceed?', 0, clearEvents, null, ignoreWarnings)); 
	});
	clear_events.color = 0xFFd9534f;
	clear_events.label.color = 0xFFffffff;

	var clear_notes = new FlxButton(190, 310, 'Clear Notes', function() {
		openSubState(new Prompt('This action will clear current progress.\n\nProceed?', 0, function(){
			for (sec in 0..._song.notes.length) {
				_song.notes[sec].sectionNotes = [];
			}
			updateGrid();
		}, null, ignoreWarnings));
	});
	clear_notes.color = 0xFFd9534f;
	clear_notes.label.color = 0xFFffffff;

	if (check_mustHitSection != null)
		updateHeads();

	tab_group_song.add(labelSongTitle);
	tab_group_song.add(UI_songTitle);
	tab_group_song.add(labelBpmSong);
	tab_group_song.add(stepperBPM);
	tab_group_song.add(labelSpeed);
	tab_group_song.add(stepperSpeed);
	tab_group_song.add(labelTimeSig);
	tab_group_song.add(stepperSongTimeSigNum);
	tab_group_song.add(stepperSongTimeSigDen);
	tab_group_song.add(labelDiff);
	tab_group_song.add(diffDropDown);
	tab_group_song.add(labelMania);
	tab_group_song.add(stepperMania);
	tab_group_song.add(check_voices);
	
	tab_group_song.add(saveButton);
	tab_group_song.add(saveEventsBtn);
	tab_group_song.add(reloadSong);
	tab_group_song.add(reloadSongJson);
	tab_group_song.add(loadAutosaveBtn);
	tab_group_song.add(loadEventJson);
	
	tab_group_song.add(isMoodyCheck);
	tab_group_song.add(isSpookyCheck);
	tab_group_song.add(isHeyCheck);
	tab_group_song.add(isCheerCheck);
	tab_group_song.add(clear_events);
	tab_group_song.add(clear_notes);

	UI_box.addGroup(tab_group_song);
	UI_box.scrollFactor.set();
	FlxG.camera.follow(camPos);
}

function getDiffByArray(daDiffName)
{
	for (i in 0...allDiffs.length)
	{
		if (allDiffs[i] == daDiffName)
			return i;
	}

	//return 4;
}

function addCharsUI()
{
	var tab_group_char = new FlxUI(null, UI_box);
	tab_group_char.name = "Char";
	playerText = new FlxText(15, 10, 110, "Player 1 (BF):", 8);
	player1TextField = new FlxUIInputText(15, 25, 110, _song.player1, 8);
	blockPressWhileTypingOn.push(player1TextField);

	enemyText = new FlxText(15, 60, 110, "Player 2 (Opponent):", 8);
	player2TextField = new FlxUIInputText(15, 75, 110, _song.player2, 8);
	blockPressWhileTypingOn.push(player2TextField);

	gfText = new FlxText(15, 110, 110, "GF:", 8);
	gfTextField = new FlxUIInputText(15, 125, 110, _song.gf, 8);
	blockPressWhileTypingOn.push(gfTextField);
	stageText = new FlxText(150, 10, 110, "Stage:", 8);
	stageTextField = new FlxUIInputText(150, 25, 110, _song.stage, 8);
	blockPressWhileTypingOn.push(stageTextField);

	cutsceneText = new FlxText(150, 60, 110, "Cutscene:", 8);
	cutsceneTextField = new FlxUIInputText(150, 75, 110, _song.cutsceneType, 8);
	blockPressWhileTypingOn.push(cutsceneTextField);

