trace(": )");

// char is a Character
function init(char)
{
	trace(": )");

	// Texture Atlas
	//var tex = FlxAtlasFrames.fromSparrow(SUtil.getPath() + 'assets/images/custom_chars/bf/char.png', SUtil.getPath() + 'assets/images/custom_chars/bf/char.xml');
	char.loadAtlas(hscriptPath + "atlas");

	trace(": )");

	// Atlas animations
	char.addAtlasAnim('idle', 'idle', 24, false);
	char.addAtlasAnim('singUP', 'idle', 24, false);
	char.addAtlasAnim('singLEFT', 'idle', 24, false);
	char.addAtlasAnim('singRIGHT', 'idle', 24, false);
	char.addAtlasAnim('singDOWN', 'idle', 24, false);

	trace("finish anim");

	// Offsets
	char.addOffset('idle', 0);
	char.addOffset('singUP', -6, 50);
	char.addOffset('singRIGHT', 0, 27);
	char.addOffset('singLEFT', -10, 10);
	char.addOffset('singDOWN', 0, -30);

	char.playAnim('idle');

	char.flipX = false;

	char.enemyOffsetX = 0;
	char.enemyOffsetY = 0;

	char.playerOffsetX = 0;
	char.playerOffsetY = 0;

	char.followCamX = 259;
	char.followCamY = -100;

	char.midpointX = 0;
	char.midpointY = 0;
}

portraitOffset = [0, 0];
dadVar = 6.1;
isPixel = false;

function update(elapsed, char)
{
	// do nothing...
}

var danced = false;

function dance(char)
{
	trace(": )");
	char.playAnim('idle');
}

trace("done");